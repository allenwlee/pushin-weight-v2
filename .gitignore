# Local git worktrees — not committed, lives in .git/worktrees/
# Adding these here so `git status`, `git ls-files`, and any tool that
# walks the repo from the root do not see a duplicate tree of the project.
/worktrees/

# compound-engineering plugin scratch state — per-session reviewer artifacts
# and run logs that have no value in git history.
/.context/

# Legacy runtime data
data/monitor.db

# Runtime data (not committed)
data/runs/raw/
data/runs/[0-9]*.json
data/runs/2026-*/
data/runs/probe_*.json
data/runs/LATEST.json
data/runs/LATEST.running.json
data/runs/LOCK
data/x_monitoring.db
data/x_monitoring.db-*
# staging.db was retired 2026-07-07 (see data/staging_archive/RETIRED.md).
# The archive dir + the file patterns below prevent accidental re-introduction
# of a stale staging.db that diverges from production x_monitoring.db.
data/staging.db
data/staging.db-*
data/staging_archive/
data/dashboard.pid
data/dashboard.log
data/dashboard-worktree.pid
data/dashboard-worktree.log
data/_review_queue.json
data/_review_queue.json.lock
data/headlines_cache.json
data/headlines_cache.json.lock
data/_qt_daily_marker

# Worktree-only runtime files (NOT committed, NOT shared with main)
run_dashboard*.py

