# x-monitor v2 — environment variables
# Copy to .env and fill in real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-local-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --- Render-specific ---
# Set by Render platform automatically; include here for local parity.
# RENDER=true
# CSRF_TRUSTED_ORIGINS=https://pushinweight-web.onrender.com

# --- Database (PostgreSQL) ---
# Local: postgres://pushinweight:pushinweight@localhost:5432/pushinweight
# Render: supplied as DATABASE_URL by the platform
DATABASE_URL=postgres://pushinweight:change-me@localhost:5432/pushinweight

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Google OAuth (django-allauth) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:8000/accounts/google/login/callback/
#   https://<your-render-service>.onrender.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ollija staging boundary (never reuse production OAuth values) ---
OLLIJA_STAGING_MODE=False
OLLIJA_STAGING_ALLOWED_EMAILS=
OLLIJA_STAGING_GOOGLE_CLIENT_ID=
OLLIJA_STAGING_GOOGLE_CLIENT_SECRET=
# Staging-only refresh switch and dedicated SELECT-only production snapshot role.
# Never configure these on the production service.
STAGING_DATA_REFRESH_ENABLED=False
STAGING_REFRESH_SOURCE_DATABASE_URL=

# --- TwitterAPI.io ---
TWITTERAPI_IO_API_KEY=
TWITTERAPI_BASE_URL=https://api.twitterapi.io

# --- Anthropic / LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=

# --- V22 shared headline narrative (dedicated worker role) ---
# In production the headline worker reads DEEPSEEK_API_KEY, scoped to this
# service without linking the broad pushinweight-secrets group.
# Keep the route/model pinned in config.yaml; null YAML fields permit overrides.
X_MONITOR_HEADLINE_PROVIDER=deepseek
X_MONITOR_HEADLINE_BASE_URL=https://api.deepseek.com/anthropic
X_MONITOR_HEADLINE_MODEL=deepseek-v4-pro
X_MONITOR_HEADLINE_TIMEOUT_SECONDS=45
X_MONITOR_HEADLINE_PROMPT_VERSION=headline-v5-analytical
X_MONITOR_HEADLINE_PUBLICATION_EPOCH=5
X_MONITOR_HEADLINE_SERVING_ENABLED=False
X_MONITOR_HEADLINE_ENQUEUE_ENABLED=False
X_MONITOR_HEADLINE_PROVIDER_CALLS_ENABLED=False
X_MONITOR_HEADLINE_CONTROL_REVISION=off-v1

# --- x-monitor specific ---
XMONITOR_DRY_RUN=False
XMONITOR_LOG_JSON=False
XMONITOR_DATA_DIR=data
