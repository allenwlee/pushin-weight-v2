#!/bin/sh
set -eu

# Git has no pre-worktree-add hook. post-checkout is the earliest portable
# point at which Ollija can warn about a linked worktree created elsewhere.
common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
repo_root="$(dirname "$common_git_dir")"
top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$common_git_dir" ] || [ -z "$top" ] || [ ! -x "$repo_root/.venv/bin/python" ]; then
  exit 0
fi

cd "$repo_root"
OLLIJA_WORKTREE_CWD="$top" exec "$repo_root/bin/ollija" worktree guard --hook
