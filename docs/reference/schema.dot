  /* legend */
  subgraph cluster_legend {
    label="legend";
    style=filled; fillcolor="#FAFAFA";
    fontsize=10;
    fontcolor="#2C3E50";
    margin=12;
    legend_pk [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FADBD8" ALIGN="LEFT"><B>column</B></TD><TD BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">PRIMARY KEY</FONT></TD></TR></TABLE>>];
    legend_fk [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#D6EAF8" ALIGN="LEFT">column</TD><TD BGCOLOR="#D6EAF8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">FOREIGN KEY</FONT></TD></TR></TABLE>>];
    legend_norm [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT">column</TD><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">type</FONT></TD></TR></TABLE>>];
    legend_pk -> legend_fk -> legend_norm [style=invis];
  }
