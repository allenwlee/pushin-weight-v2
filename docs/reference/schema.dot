<TR><TD PORT="is_regex" BGCOLOR="#FFFFFF" ALIGN="LEFT">is_regex</TD><TD PORT="is_regex_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">BOOL</FONT></TD></TR>
<TR><TD PORT="is_primary" BGCOLOR="#FFFFFF" ALIGN="LEFT">is_primary</TD><TD PORT="is_primary_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">BOOL</FONT></TD></TR>
<TR><TD PORT="added_at" BGCOLOR="#FFFFFF" ALIGN="LEFT">added_at</TD><TD PORT="added_at_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TIMESTAMPTZ</FONT></TD></TR>
</TABLE>>];

    brand_search_terms [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
<TR><TD COLSPAN="2" BGCOLOR="#34495E"><FONT COLOR="white" POINT-SIZE="12"><B>brand_search_terms</B></FONT></TD></TR>
<TR><TD PORT="brand_id" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>brand_id <FONT COLOR="#2874A6" POINT-SIZE="9">FK</FONT></B></TD><TD PORT="brand_id_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="term" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>term <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="term_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="added_at" BGCOLOR="#FFFFFF" ALIGN="LEFT">added_at</TD><TD PORT="added_at_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TIMESTAMPTZ</FONT></TD></TR>
</TABLE>>];

    brand_hashtags [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
<TR><TD COLSPAN="2" BGCOLOR="#34495E"><FONT COLOR="white" POINT-SIZE="12"><B>brand_hashtags</B></FONT></TD></TR>
<TR><TD PORT="brand_id" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>brand_id <FONT COLOR="#2874A6" POINT-SIZE="9">FK</FONT></B></TD><TD PORT="brand_id_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="tag" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>tag <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="tag_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="added_at" BGCOLOR="#FFFFFF" ALIGN="LEFT">added_at</TD><TD PORT="added_at_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TIMESTAMPTZ</FONT></TD></TR>
</TABLE>>];
  }

  /* =========================================================================
     Control — cycle tracking and search queries
     ========================================================================= */
  subgraph cluster_control {
    label="control";
    style=filled; fillcolor="#F4ECF7";
    fontname="Helvetica";
    fontsize=12;
    fontcolor="#2C3E50";
    margin=12;

    search_queries [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
<TR><TD COLSPAN="2" BGCOLOR="#34495E"><FONT COLOR="white" POINT-SIZE="12"><B>search_queries</B></FONT></TD></TR>
<TR><TD PORT="id" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>id <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="id_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">BIGINT</FONT></TD></TR>
<TR><TD PORT="query_id" BGCOLOR="#FFFFFF" ALIGN="LEFT">query_id <FONT COLOR="#C0392B" POINT-SIZE="8">U</FONT></TD><TD PORT="query_id_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="brand_id" BGCOLOR="#D6EAF8" ALIGN="LEFT">brand_id <FONT COLOR="#2874A6" POINT-SIZE="9">FK</FONT></TD><TD PORT="brand_id_t" BGCOLOR="#D6EAF8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="keywords_json" BGCOLOR="#FFFFFF" ALIGN="LEFT">keywords_json</TD><TD PORT="keywords_json_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">JSON</FONT></TD></TR>
<TR><TD PORT="plan_calls_run_id" BGCOLOR="#FFFFFF" ALIGN="LEFT">plan_calls_run_id</TD><TD PORT="plan_calls_run_id_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="created_at" BGCOLOR="#FFFFFF" ALIGN="LEFT">created_at</TD><TD PORT="created_at_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TIMESTAMPTZ</FONT></TD></TR>
</TABLE>>];

    call_state [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
<TR><TD COLSPAN="2" BGCOLOR="#34495E"><FONT COLOR="white" POINT-SIZE="12"><B>call_state</B></FONT></TD></TR>
<TR><TD PORT="brand_id" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>brand_id <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="brand_id_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="call_id" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>call_id <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="call_id_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="call_kind" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>call_kind <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="call_kind_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="bucket" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>bucket <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="bucket_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="query_id" BGCOLOR="#FADBD8" ALIGN="LEFT"><B>query_id <FONT COLOR="#C0392B" POINT-SIZE="9">PK</FONT></B></TD><TD PORT="query_id_t" BGCOLOR="#FADBD8" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TEXT</FONT></TD></TR>
<TR><TD PORT="last_completed_at" BGCOLOR="#FFFFFF" ALIGN="LEFT">last_completed_at</TD><TD PORT="last_completed_at_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TIMESTAMPTZ</FONT></TD></TR>
<TR><TD PORT="updated_at" BGCOLOR="#FFFFFF" ALIGN="LEFT">updated_at</TD><TD PORT="updated_at_t" BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT COLOR="#7F8C8D">TIMESTAMPTZ</FONT></TD></TR>
</TABLE>>];
  }

  /* =========================================================================
     Foreign-key edges
     ========================================================================= */

  /* --- Label → Key lookup edges --- */
  post_type_labels:key_t -> post_type_keys:key_t [color="#7F8C8D"];
  sentiment_labels:key_t -> sentiment_keys:key_t [color="#7F8C8D"];
  discourse_labels:key_t -> discourse_keys:key_t [color="#7F8C8D"];
  nationalism_labels:key_t -> nationalism_keys:key_t [color="#7F8C8D"];
  role_labels:key_t -> roles:key_t [color="#7F8C8D"];

  /* --- Entity FK edges --- */
  hf_orgs:company_id_t -> companies:nickname_t [color="#C0392B"];
  posts:author_id_t -> accounts:author_id_t [color="#7D6608"];

  /* --- Junction FK edges --- */
  brands_companies:brand_id_t -> brands:nickname_t [color="#C0392B"];
  brands_companies:company_id_t -> companies:nickname_t [color="#C0392B"];
  brands_accounts:brand_id_t -> brands:nickname_t [color="#C0392B"];
  brands_accounts:accounts_id_t -> accounts:author_id_t [color="#C0392B"];
  brands_accounts:role_id_t -> roles:key_t [color="#7F8C8D"];
  companies_accounts:company_id_t -> companies:nickname_t [color="#C0392B"];
  companies_accounts:author_id_t -> accounts:author_id_t [color="#C0392B"];
  companies_accounts:role_id_t -> roles:key_t [color="#7F8C8D"];

  /* --- Content FK edges (post → brand/account) --- */
  posts_brands:post_id_t -> posts:tweet_id_t [color="#C0392B"];
  posts_brands:brand_id_t -> brands:nickname_t [color="#7D6608"];
  posts_brands_mentions:post_id_t -> posts:tweet_id_t [color="#C0392B"];
  posts_brands_mentions:brand_id_t -> brands:nickname_t [color="#7D6608"];
  posts_brands_signals:post_id_t -> posts:tweet_id_t [color="#C0392B"];
  posts_brands_signals:brand_id_t -> brands:nickname_t [color="#7D6608"];
  posts_brands_signals:post_type_key_t -> post_type_keys:key_t [color="#7F8C8D"];
  posts_brands_signals:sentiment_t -> sentiment_keys:key_t [color="#7F8C8D"];
  posts_brands_discourse:post_id_t -> posts:tweet_id_t [color="#C0392B"];
  posts_brands_discourse:brand_id_t -> brands:nickname_t [color="#7D6608"];
  posts_brands_discourse:discourse_key_t -> discourse_keys:key_t [color="#7F8C8D"];
  posts_brands_discourse:china_nationalism_t -> nationalism_keys:key_t [color="#7F8C8D"];
  posts_brands_discourse:us_nationalism_t -> nationalism_keys:key_t [color="#7F8C8D"];
  posts_unsanctioned_flags:post_id_t -> posts:tweet_id_t [color="#C0392B"];
  account_post_appearances:author_id_t -> accounts:author_id_t [color="#C0392B"];
  account_post_appearances:tweet_id_t -> posts:tweet_id_t [color="#C0392B"];

  /* --- Product FK edges --- */
  products:brand_id_t -> brands:nickname_t [color="#7D6608"];
  products:hf_org_id_t -> hf_orgs:namespace_t [color="#7D6608"];

  /* --- Attribution FK edges --- */
  brand_keywords:brand_id_t -> brands:nickname_t [color="#C0392B"];
  brand_search_terms:brand_id_t -> brands:nickname_t [color="#C0392B"];
  brand_hashtags:brand_id_t -> brands:nickname_t [color="#C0392B"];

  /* --- Control FK edges --- */
  search_queries:brand_id_t -> brands:nickname_t [color="#7D6608"];
}
