  post_type_labels:"key" -> post_type_keys:"key";
  posts:"author_id" -> accounts:"id";
  posts_brands:"brand_id" -> brands:"id";
  posts_brands:"post_id" -> posts:"id";
  posts_brands_mentions:"brand_id" -> brands:"id";
  posts_brands_mentions:"post_id" -> posts:"id";
  posts_brands_signals:"sentiment" -> sentiment_keys:"id";
