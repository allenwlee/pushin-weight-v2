<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{AGENT_ATTRIBUTION}}
     LaunchAgent label: com.fuchitalee.x-monitor.config-reload
     Role: event-driven; fires when config.yaml changes (WatchPaths).
     Pair with com.fuchitalee.x-monitor.harvest (15-min scheduled cadence).
     ThrottleInterval 300s prevents a flurry of edits from queueing runs. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fuchitalee.x-monitor.config-reload</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>/Users/fuchitalee/development/minimax-marketing/x-monitoring/deploy/run-pipeline-watchpaths.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/fuchitalee/development/minimax-marketing/x-monitoring</string>

    <key>WatchPaths</key>
    <array>
        <!-- Plan 2026-07-11-001: data/queries/ is retired (per-brand
             yamls deleted; brand_keywords is the runtime source via DB).
             Plan 2026-07-11-002 (U4): data/accounts/ is also retired
             (per-brand official/staff handles live in brands_accounts).
             The only operator-edit surface that needs a launchd rerun
             trigger is config.yaml (x_query_specs:, daily_ceiling, etc.).
             DB-touching migrations run via x-monitor migrate, not via
             WatchPaths. -->
        <string>/Users/fuchitalee/development/minimax-marketing/x-monitoring/config.yaml</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/fuchitalee/Library/Logs/x-monitor/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/fuchitalee/Library/Logs/x-monitor/stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
