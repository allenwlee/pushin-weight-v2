{# {{AGENT_ATTRIBUTION}} #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>x-monitor — combined</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='dashboard.css') }}">
  <script src="https://unpkg.com/htmx.org@1.9.10" defer></script>
  <script src="https://unpkg.com/chart.js@4.4.0" defer></script>
  <script src="{{ url_for('static', filename='combined-chart.js') }}" defer></script>
  <script src="{{ url_for('static', filename='dashboard.js') }}" defer></script>
</head>
<body>
  <header class="topbar">
    <h1>x-monitor</h1>
    {# Topbar nav strip: 3 tabs (Treemap | Combined | 9-Card Grid). #}
    <nav class="view-tabs" aria-label="View switcher">
      <a class="view-tab {{ 'is-active' if request_endpoint == 'index' else '' }}"
         href="/"
         {{ 'aria-current="page"' | safe if request_endpoint == 'index' else '' }}>Treemap</a>
      <a class="view-tab {{ 'is-active' if request_endpoint == 'combined' else '' }}"
         href="/combined"
         {{ 'aria-current="page"' | safe if request_endpoint == 'combined' else '' }}>Combined</a>
      <a class="view-tab {{ 'is-active' if request_endpoint == 'grid' else '' }}"
         href="/grid"
         {{ 'aria-current="page"' | safe if request_endpoint == 'grid' else '' }}>9-Card Grid</a>
    </nav>
    {# Combined chart window toggle (1d / 7d / 14d / 30d / 60d / 90d / 180d / 360d). #}
    <nav class="window-toggle" aria-label="Combined chart window selector">
      <span class="window-toggle-label">window:</span>
      {% for n in allowed_combined_windows %}
        <a class="window-tab {{ 'is-active' if combined_window_days == n else '' }}"
           href="/api/combined_window/{{ n }}"
           {{ 'aria-current="true"' | safe if combined_window_days == n else '' }}>{{ n }}d</a>
      {% endfor %}
    </nav>
    <span class="muted" id="last-run-stamp"
          data-finished-at="{{ last_run_at or '' }}">
      last updated: {{ last_run_at or 'never' }}
    </span>
    <span class="muted">{{ brands|length }} models · {{ combined_window_days }}d window · polling every {{ poll_seconds }}s</span>
  </header>

  <main id="combined-chart" class="combined-chart-wrap"
        data-combined='{{ payload|tojson }}'
        hx-get="/api/combined.html"
        hx-trigger="every {{ poll_seconds }}s"
        hx-swap="innerHTML">
    <canvas class="combined-chart"
            aria-label="Daily total posts per brand, last {{ combined_window_days }} days"></canvas>
  </main>
</body>
</html>