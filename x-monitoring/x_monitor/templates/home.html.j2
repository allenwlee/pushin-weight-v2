{# {{AGENT_ATTRIBUTION}} #}
{# Pushin' Weight multi-brand home page (R5-R11, U6 of
   feat/pushin-weight-home-pages). #}
<!doctype html>
<html lang="{{ active_locale.split('-')[0] }}">
<head>
  <meta charset="utf-8">
  <title>{{ app_name_zh }} · multi-brand</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='dashboard.css') }}">
  <script src="https://unpkg.com/htmx.org@1.9.10" defer></script>
  <script src="https://unpkg.com/chart.js@4.4.0" defer></script>
  <script src="{{ url_for('static', filename='pw-filter-store.js') }}" defer></script>
  <script src="{{ url_for('static', filename='pw-chart.js') }}" defer></script>
  <script src="{{ url_for('static', filename='pw-brand-chart.js') }}" defer></script>
  <script src="{{ url_for('static', filename='pw-feed.js') }}" defer></script>
  <script src="{{ url_for('static', filename='pw-locale-toggle.js') }}" defer></script>
  <script src="{{ url_for('static', filename='dashboard.js') }}" defer></script>
</head>
<body data-pw-filters='{{ chart.applied_filters|tojson }}'
      data-pw-brands='{{ brands|tojson }}'
      data-pw-locale="{{ active_locale }}"
      data-pw-window="{{ home_window_days }}"
      data-pw-page="multi">
  <header class="topbar">
    <h1>{{ app_name_zh }} <small>{{ app_name_en }}</small></h1>
    <span class="muted">{{ brands|length }} models · {{ home_window_days }}d window</span>

    <nav class="window-toggle" aria-label="Time-period selector">
      <span class="window-toggle-label">window:</span>
      {% for n in allowed_home_windows %}
        <button class="window-btn {{ 'is-active' if home_window_days == n else '' }}"
                data-pw-window-btn="{{ n }}">{{ n }}d</button>
      {% endfor %}
    </nav>

    <nav class="locale-toggle" aria-label="Display language">
      <span class="locale-toggle-label">lang:</span>
      <button class="locale-btn {{ 'is-active' if active_locale == 'zh_cn' or active_locale == 'zh-CN' else '' }}"
              data-pw-locale-btn="zh_cn">中文</button>
      <button class="locale-btn {{ 'is-active' if active_locale == 'en' else '' }}"
              data-pw-locale-btn="en">EN</button>
      <button class="locale-btn {{ 'is-active' if active_locale == 'original' else '' }}"
              data-pw-locale-btn="original">orig</button>
    </nav>
  </header>

  <main class="home-pane">
    <section class="home-chart-wrap"
             id="home-chart"
             hx-get="/api/v1/home.chart.html"
             hx-trigger="every {{ poll_seconds }}s"
             hx-swap="innerHTML">
      {% with chart=chart, payload=chart %}
        {% include "_home_chart.html.j2" %}
      {% endwith %}
    </section>

    <aside class="control-panel" id="control-panel">
      <h2>Filters</h2>
      <div class="control-group">
        <div class="control-group-title">Brands</div>
        {% for brand in brands %}
          <label class="control-row" style="--swatch: {{ brand_accent_colors.get(brand, '#9ca3af') }};">
            <input type="checkbox" data-pw-filter-group="brands" value="{{ brand }}" checked>
            <span class="swatch" style="background: {{ brand_accent_colors.get(brand, '#9ca3af') }};"></span>
            {{ brand_display_names.get(brand, brand) }}
          </label>
        {% endfor %}
      </div>

      <div class="control-group">
        <div class="control-group-title">Discourse</div>
        {% for key in discourse_keys %}
          <label class="control-row">
            <input type="checkbox" data-pw-filter-group="discourse" value="{{ key }}" checked>
            {{ key }}
          </label>
        {% endfor %}
      </div>

      <div class="control-group">
        <div class="control-group-title">post_type</div>
        {% for key in post_type_keys %}
          <label class="control-row">
            <input type="checkbox" data-pw-filter-group="post_types" value="{{ key }}" checked>
            {{ key }}
          </label>
        {% endfor %}
      </div>

      <div class="control-group">
        <div class="control-group-title">account.role</div>
        {% for key in role_keys %}
          <label class="control-row">
            <input type="checkbox" data-pw-filter-group="role" value="{{ key }}" checked>
            {{ key }}
          </label>
        {% endfor %}
      </div>

      <div class="control-group">
        <div class="control-group-title">us_nationalism</div>
        {% for key in nationalism_keys %}
          <label class="control-row">
            <input type="checkbox" data-pw-filter-group="us_nationalism" value="{{ key }}" checked>
            {{ key }}
          </label>
        {% endfor %}
      </div>

      <div class="control-group">
        <div class="control-group-title">cn_nationalism</div>
        {% for key in nationalism_keys %}
          <label class="control-row">
            <input type="checkbox" data-pw-filter-group="cn_nationalism" value="{{ key }}" checked>
            {{ key }}
          </label>
        {% endfor %}
      </div>

      <div class="control-group">
        <div class="control-group-title">unsanctioned</div>
        <label class="control-row">
          <input type="checkbox" data-pw-filter-group="unsanctioned" value="only">
          show only flagged posts
        </label>
      </div>
    </aside>
  </main>

  <section class="feed" id="feed"
           data-pw-feed
           data-pw-locale="{{ active_locale }}">
    <table>
      <thead>
        <tr>
          <th><button data-pw-sort="created_at" data-pw-order="desc">datetime</button></th>
          <th>brand</th>
          <th>translated</th>
          <th>original</th>
          <th>classifications</th>
          <th>handle</th>
        </tr>
      </thead>
      <tbody data-pw-feed-body>
        {% include "_feed_initial.html.j2" %}
      </tbody>
    </table>
    <div class="feed-sentinel" data-pw-feed-sentinel>loading more…</div>
    <div class="feed-end" data-pw-feed-end hidden>end of feed</div>
  </section>

  <aside id="api-spend" class="spend-panel-wrap"
         hx-get="/api/spend.html"
         hx-trigger="every {{ poll_seconds }}s"
         hx-swap="innerHTML">
    {% include "_spend_panel.html.j2" %}
  </aside>
</body>
</html>
