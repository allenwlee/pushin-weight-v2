{# {{AGENT_ATTRIBUTION}} #}
<div class="model-card" data-model-id="{{ card.model_id }}" style="--accent: {{ card.accent_color }};">
  <a class="card-link" href="/model/{{ card.model_id }}">
    <header class="card-head">
      <h2>{{ card.display_name }}</h2>
      <span class="model-id muted">{{ card.model_id }}</span>
    </header>
    <div class="trend-chart-wrap" data-chart='{{ card.chart|tojson }}'>
      <canvas class="trend-chart"
              data-model-id="{{ card.model_id }}"
              aria-label="Daily tweet volume by signal, last 14 days"></canvas>
    </div>
    <ul class="top3">
      {% for p in card.top3_posts %}
        <li>
          <span class="faves">★{{ p.favorite_count }}</span>
          <span class="text">{{ p.text }}</span>
          {% if p.url %}<a class="ext" href="{{ p.url }}" target="_blank" rel="noopener">↗</a>{% endif %}
        </li>
      {% else %}
        <li class="muted small">no top posts yet</li>
      {% endfor %}
    </ul>
    <footer class="card-foot">
      <span class="muted small">{{ card.n_posts_in_window }} posts · {{ card.last_run_at or 'no run' }}</span>
      <span class="sentinels">
        {% for s in card.degraded_sentinels %}
          <span class="badge {{ 'red' if s == 'cookies' else 'yellow' }}">{{ s }}</span>
        {% endfor %}
      </span>
    </footer>
  </a>
</div>
