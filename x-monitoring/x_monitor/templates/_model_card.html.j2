{# {{AGENT_ATTRIBUTION}} #}
<div class="model-card" data-brand-id="{{ card.brand_id }}" data-href="/brand/{{ card.brand_id }}" style="--accent: {{ card.accent_color }};">
  <header class="card-head">
      <h2>{{ card.display_name }}</h2>
      <span class="model-id muted">{{ card.brand_id }}</span>
    </header>
    <div class="trend-chart-wrap" data-chart='{{ card.chart|tojson }}'{% if card.signal_labels_json %} data-signal-labels='{{ card.signal_labels_json }}'{% endif %}>
      <canvas class="trend-chart"
              data-brand-id="{{ card.brand_id }}"
              aria-label="Daily tweet volume by signal, last 14 days"></canvas>
    </div>
    <div class="top3-grid">
      <section class="top3-col">
        <h3 class="top3-header">last 7 days <span class="count">[{{ card.n_posts_7d }}]</span></h3>
        <ul class="top3">
          {% for p in card.top3_7d %}
            <li class="top3-item">
              <a class="top3-link" href="{{ p.url }}" target="_blank" rel="noopener">
                <span class="faves">★{{ p.like_count }}</span>
                <span class="text{% if p.headline %} with-headline{% endif %}{% if p.is_translated == false %} source-fallback{% endif %}"
                      {% if p.headline_source %}data-headline-source="{{ p.headline_source }}"{% endif %}>{{ p.display_text | brand_colorize }}</span>
              </a>
            </li>
          {% else %}
            <li class="muted small">no top posts in window</li>
          {% endfor %}
        </ul>
      </section>
      <section class="top3-col">
        <h3 class="top3-header">last 24 hrs <span class="count">[{{ card.n_posts_24h }}]</span></h3>
        <ul class="top3">
          {% for p in card.top3_24h %}
            <li class="top3-item">
              <a class="top3-link" href="{{ p.url }}" target="_blank" rel="noopener">
                <span class="faves">★{{ p.like_count }}</span>
                <span class="text{% if p.headline %} with-headline{% endif %}{% if p.is_translated == false %} source-fallback{% endif %}"
                      {% if p.headline_source %}data-headline-source="{{ p.headline_source }}"{% endif %}>{{ p.display_text | brand_colorize }}</span>
              </a>
            </li>
          {% else %}
            <li class="muted small">no top posts in window</li>
          {% endfor %}
        </ul>
      </section>
    </div>
    <footer class="card-foot">
      <span class="muted small">{{ card.n_posts_in_window }} posts · {{ card.last_run_at or 'no run' }}</span>
      <span class="sentinels">
        {% for s in card.degraded_sentinels %}
          <span class="badge {{ 'red' if s == 'cookies' else 'yellow' }}">{{ s }}</span>
        {% endfor %}
      </span>
    </footer>
</div>
