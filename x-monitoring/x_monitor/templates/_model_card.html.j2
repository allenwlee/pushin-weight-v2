{# {{AGENT_ATTRIBUTION}} #}
<div class="model-card" data-model-id="{{ card.model_id }}" style="--accent: {{ card.accent_color }};">
  <a class="card-link" href="/model/{{ card.model_id }}">
    <header class="card-head">
      <h2>{{ card.display_name }}</h2>
      <span class="model-id muted">{{ card.model_id }}</span>
    </header>
    <div class="sparkline-wrap" style="color: var(--accent);">
      {{ card.sparkline_svg|safe }}
    </div>
    <div class="signal-bar">
      {% set total = (card.signal_breakdown.values()|sum) %}
      {% if total > 0 %}
        <span class="seg release" style="width: {{ (card.signal_breakdown.get('release', 0) / total * 100)|round(1) }}%"></span>
        <span class="seg community" style="width: {{ (card.signal_breakdown.get('community_question', 0) / total * 100)|round(1) }}%"></span>
        <span class="seg criticism" style="width: {{ (card.signal_breakdown.get('criticism', 0) / total * 100)|round(1) }}%"></span>
        <span class="seg other" style="width: {{ (card.signal_breakdown.get('other', 0) + card.signal_breakdown.get('commenter_capture', 0)) / total * 100|round(1) }}%"></span>
        <span class="seg praise" style="width: {{ (card.signal_breakdown.get('praise', 0) / total * 100)|round(1) }}%"></span>
      {% else %}
        <span class="muted small">no posts in window</span>
      {% endif %}
    </div>
    <ul class="top3">
      {% for p in card.top3_posts %}
        <li>
          <span class="faves">★{{ p.favorite_count }}</span>
          <span class="text">{{ p.text }}</span>
          {% if p.url %}<a class="ext" href="{{ p.url }}" target="_blank" rel="noopener">↗</a>{% endif %}
        </li>
      {% else %}
        <li class="muted small">no top posts yet</li>
      {% endfor %}
    </ul>
    <footer class="card-foot">
      <span class="muted small">{{ card.n_posts_in_window }} posts · {{ card.last_run_at or 'no run' }}</span>
      <span class="sentinels">
        {% for s in card.degraded_sentinels %}
          <span class="badge {{ 'red' if s == 'cookies' else 'yellow' }}">{{ s }}</span>
        {% endfor %}
      </span>
    </footer>
  </a>
</div>
