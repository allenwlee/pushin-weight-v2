{# {{AGENT_ATTRIBUTION}} #}
<!doctype html>
<html lang="{{ active_locale.split('-')[0] }}">
<head>
  <meta charset="utf-8">
  <title>x-monitor — {{ cards|length }} models</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='dashboard.css') }}">
  <script src="https://unpkg.com/htmx.org@1.9.10" defer></script>
  <script src="https://unpkg.com/chart.js@4.4.0" defer></script>
  <script src="{{ url_for('static', filename='trend-chart.js') }}" defer></script>
  <script src="{{ url_for('static', filename='dashboard.js') }}" defer></script>
</head>
<body>
  <header class="topbar">
    <h1>x-monitor</h1>
    {# Topbar nav strip: 2 tabs (Treemap | 9-Card Grid) with active state set
       server-side based on request.endpoint. aria-current="page" gives screen
       readers the active tab. #}
    <nav class="view-tabs" aria-label="View switcher">
      <a class="view-tab {{ 'is-active' if request_endpoint == 'index' else '' }}"
         href="/"
         {{ 'aria-current="page"' | safe if request_endpoint == 'index' else '' }}>Treemap</a>
      <a class="view-tab {{ 'is-active' if request_endpoint == 'combined' else '' }}"
         href="/combined"
         {{ 'aria-current="page"' | safe if request_endpoint == 'combined' else '' }}>Combined</a>
      <a class="view-tab {{ 'is-active' if request_endpoint == 'grid' else '' }}"
         href="/grid"
         {{ 'aria-current="page"' | safe if request_endpoint == 'grid' else '' }}>9-Card Grid</a>
    </nav>
    <span class="muted" id="last-run-stamp"
          data-finished-at="{{ cards[0].last_run_at or '' }}">
      last updated: {{ cards[0].last_run_at or 'never' }}
    </span>
    <span class="muted">{{ cards|length }} models · polling every {{ poll_seconds }}s</span>
    <nav class="locale-switcher" aria-label="Display language">
      {# POST form sets the `locale` cookie via /api/set_locale.
         The hx-get poll on <main> below preserves the cookie on
         subsequent requests, so the locale sticks across polls. #}
      <form method="POST" action="/api/set_locale" class="locale-form">
        <button type="submit" name="locale" value="en"
                class="locale-link {% if active_locale == 'en' %}active{% endif %}"
                aria-label="English">EN</button>
        <span class="locale-sep" aria-hidden="true">|</span>
        <button type="submit" name="locale" value="zh-CN"
                class="locale-link {% if active_locale in ('zh-CN', 'zh_cn') %}active{% endif %}"
                aria-label="简体中文">中文</button>
      </form>
    </nav>
  </header>
  {# hx-swap="innerHTML" so the <main> element persists across polls — that
     keeps the hx-trigger attribute attached, so polling continues. The JSON
     endpoint stays for external consumers; the HTML one drives the live UI. #}
  <main id="grid" class="grid"
        hx-get="/api/grid.html"
        hx-trigger="every {{ poll_seconds }}s"
        hx-swap="innerHTML">
    {% include "_grid_cards.html.j2" %}
  </main>
</body>
</html>
